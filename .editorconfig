# ============================================
# 🛡️ MantraLab — .editorconfig (MIL‑PRO v1.0)
# Discipline du code • Normalisation globale
# ============================================

root = true

# ----- Règles globales -----
[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ----- Markdown -----
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# ----- reStructuredText -----
[*.rst]
indent_size = 3
trim_trailing_whitespace = false

# ----- JSON / YAML / TOML -----
[*.json]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 2

# ----- Python -----
[*.py]
indent_size = 4
max_line_length = 120

# ----- Bash / Shell -----
[*.sh]
indent_style = space
indent_size = 4

# ----- PowerShell -----
[*.ps1]
indent_style = space
indent_size = 4

# ----- JavaScript / TypeScript -----
[*.{js,ts}]
indent_size = 2

# ----- HTML / CSS -----
[*.{html,css}]
indent_size = 2

# ----- Manifests -----
[manifests/**]
indent_size = 2

# ----- Scripts -----
[scripts/**]
indent_size = 4

# ----- Documentation -----
[docs/**]
indent_size = 3
trim_trailing_whitespace = false

# ----- GitHub -----
[.github/**]
indent_size = 2
trim_trailing_whitespace = false
